# AI Tutor Backend Environment Configuration
# Copy this to .env and fill in real values

# Firebase Admin SDK (download from Firebase Console)
FIREBASE_PROJECT_ID=lexora-ba446
FIREBASE_PRIVATE_KEY_ID=your_key_id_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=123456789
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# OpenAI API (never expose in frontend)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-3.5-turbo

# Server Configuration
PORT=3000
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# CORS (adjust for production)
CORS_ORIGIN=http://localhost:3000,https://fahim23221.github.io
